# Copy to frontend/.env.local and adjust. Never commit frontend/.env.local.

# Base URL of the FastAPI backend (no trailing slash, no /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match AUTH_COOKIE_NAME in backend/.env. Only used by the Next.js
# middleware to decide whether to redirect to /login before rendering.
NEXT_PUBLIC_AUTH_COOKIE_NAME=ws_access_token
