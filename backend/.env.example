# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Application ---
ENVIRONMENT=development
PROJECT_NAME=Web Scanner API
API_PREFIX=/api

# --- Database ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://webscanner:CHANGE_THIS_PASSWORD@localhost:5432/webscanner
DATABASE_ECHO=false

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Auth cookie ---
AUTH_COOKIE_NAME=ws_access_token
# Set to true in every environment served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Set to a shared parent domain (e.g. .example.com) when the API and the UI live
# on different subdomains. Leave blank for localhost development.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000

# --- Scanner ---
SCANNER_TIMEOUT_SECONDS=10
SCANNER_TOTAL_TIMEOUT_SECONDS=150
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=262144
SCANNER_USER_AGENT=WebScanner/0.1 (+https://github.com/local/web-scanner)
# Leave false. Enabling it lets users scan loopback/private addresses (SSRF).
SCANNER_ALLOW_PRIVATE_NETWORKS=false

# --- Crawler (phase 4) ---
CRAWLER_ENABLED=true
# Hard caps. The crawl also stops on CRAWLER_TIME_BUDGET_SECONDS, so it can
# never run unbounded against a large site.
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=3
# Must stay below SCANNER_TOTAL_TIMEOUT_SECONDS to leave room for the probe.
CRAWLER_TIME_BUDGET_SECONDS=90
CRAWLER_MAX_REDIRECTS_PER_PAGE=3

# --- Active probing (phase 7) ---
# Budgets shared by every active detector in a scan. Probes only ever target
# URLs already inside the authorised scan scope, through the same transport as
# every other request. Set false to disable all active testing.
ACTIVE_SCAN_ENABLED=true
MAX_ACTIVE_PROBES_PER_PARAMETER=4
MAX_ACTIVE_PROBES_PER_ENDPOINT=24
MAX_ACTIVE_PROBES_PER_SCAN=120
ACTIVE_SCAN_MAX_TARGETS=25
# Parameters the reflected-XSS detector tests on one endpoint. The budgets
# above still apply on top of this.
XSS_MAX_PARAMETERS_PER_ENDPOINT=8

